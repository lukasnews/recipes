<?xml version="1.0" encoding="utf-8"?>
<!-- Samsung-like widget settings: the real wallpaper shows behind the
     preview (wallpaper theme), settings in a dark panel below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:shadowColor="#99000000"
        android:shadowRadius="4"
        android:text="@string/widget_settings_title"
        android:textColor="@color/config_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="160dp"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="16dp">

            <include
                android:id="@+id/preview"
                layout="@layout/shopping_widget" />
        </FrameLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E6000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/config_panel"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_settings_background"
                    android:textColor="@color/config_text"
                    android:textSize="18sp" />

                <Switch
                    android:id="@+id/background"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/config_panel"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/opacity_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/config_text"
                    android:textSize="18sp" />

                <SeekBar
                    android:id="@+id/opacity"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:max="100" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/widget_settings_colors"
                    android:textColor="@color/config_text"
                    android:textSize="18sp" />

                <RadioGroup
                    android:id="@+id/colors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/colors_auto"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/widget_settings_colors_auto"
                        android:textColor="@color/config_text" />

                    <RadioButton
                        android:id="@+id/colors_light"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/widget_settings_colors_light"
                        android:textColor="@color/config_text" />

                    <RadioButton
                        android:id="@+id/colors_dark"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/widget_settings_colors_dark"
                        android:textColor="@color/config_text" />

                    <RadioButton
                        android:id="@+id/colors_green"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/widget_settings_colors_green"
                        android:textColor="@color/config_text" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/config_buttons"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <Button
                    android:id="@+id/cancel"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="120dp"
                    android:text="@string/widget_settings_cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/config_text"
                    android:textSize="17sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:background="#55FFFFFF" />

                <Button
                    android:id="@+id/done"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="120dp"
                    android:text="@string/widget_settings_done"
                    android:textAllCaps="false"
                    android:textColor="@color/config_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
