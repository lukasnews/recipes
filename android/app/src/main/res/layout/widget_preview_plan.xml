<?xml version="1.0" encoding="utf-8"?>
<!-- Preview in the widget picker (Android 12+), sample texts.
     Based on shopping_widget.xml. The background is an image so its
     transparency can be set per widget (setImageAlpha) and the rounded
     corners stay. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_auto"
        android:alpha="0.7" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/widget_title"
            android:text="@string/plan_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
                        android:textColor="@color/widget_title"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_today"
            android:text="@string/preview_today"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:ellipsize="end"
                        android:textColor="@color/widget_today"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/widget_items"
            android:text="@string/preview_plan_items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
                        android:textColor="@color/widget_items"
            android:textSize="17sp" />
    </LinearLayout>
</FrameLayout>
